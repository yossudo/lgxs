diff --git a/Application/tai.c b/Application/tai.c
index e69de29..abcd123 100644
--- a/Application/tai.c
+++ b/Application/tai.c
@@ -1,6 +1,26 @@
+// Added feature extraction 16-dimension support
+#include "user_res.h"
+
+static float32_t feat16[FEAT_DIM];
+
+static int run_inference_feat(const float32_t *feat, float *score_out) {
+    // Dummy inference: threshold on energy
+    float sum = 0.0f;
+    for (int i=0;i<FEAT_DIM;i++) sum += feat[i];
+    *score_out = sum / FEAT_DIM / 1000.0f; // normalized dummy score
+    return (*score_out > 0.5f) ? 1 : 0;    // 1=anomaly,0=normal
+}
+
 void task_tai(INT stacd, void *exinf)
 {
-    // original empty body
+    while (1) {
+        msg_ai_req_t *preq;
+        if (rcv_mbx(TAI_MBXID,(T_MSG **)&preq,TMO_FEVR)==E_OK) {
+            float score;
+            int result = run_inference_feat(preq->feat,&score);
+            msg_ai_res_t *pout = (msg_ai_res_t*)get_mpf(TAI_MPFID);
+            pout->label=result;
+            pout->score=score;
+            snd_mbx(TAPP_MBXID,(T_MSG*)pout);
+        }
+    }
 }
